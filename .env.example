# ─────────────────────────────────────────────────────────────────────────────
# AdScope ortam değişkenleri. Bu dosyayı .env.local olarak kopyalayın.
# NEXT_PUBLIC_ ile başlayan her değer tarayıcıya gider: oraya ASLA gizli anahtar koymayın.
# ─────────────────────────────────────────────────────────────────────────────

# demo | production
#  demo       : "Demo modu" bandı görünür, demo kredi satın alma açıktır (gerçek ödeme yok).
#               Supabase değişkenleri boşsa bellek içi demo veri katmanı kullanılır.
#  production : demo satın alma kapalıdır, Supabase zorunludur.
# Vercel Production dağıtımında (VERCEL_ENV=production) bu değer ne olursa olsun production sayılır.
# Üretim kurulumu: docs/KURULUM.md
APP_MODE=demo

# Uygulamanın dış adresi (e-posta doğrulama bağlantıları için).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API Keys. Publishable key tarayıcıya gidebilir; secret key yalnızca sunucuda.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Sunucuya özel. Yalnızca webhook, kredi fonksiyonları ve hesap silme için kullanılır.
SUPABASE_SECRET_KEY=

# ── Yapay zekâ (isteğe bağlı) ───────────────────────────────────────────────
# Boşsa analizler deterministik kural motoruyla tamamlanır.
ANTHROPIC_API_KEY=
# Varsayılan: claude-opus-5-5
ANTHROPIC_MODEL=

# ── Görsel sağlayıcısı: Photoroom (isteğe bağlı) ───────────────────────────
# Boşsa arka plan kaldırma, büyütme ve ürün sahnesi araçları kapalıdır; boyutlandırma ve filigran
# tarayıcıda çalışmaya devam eder. Anahtar: https://app.photoroom.com/api-dashboard
# "sandbox_" ile başlayan anahtar filigranlı sonuç verir (deneme içindir).
# Fotoğraflar dosya bilgileri silinerek gönderilir; Photoroom ABD'de işler ve API görsellerini saklamadığını belirtir.
PHOTOROOM_API_KEY=

# ── Konuşmayı yazıya dökme (isteğe bağlı) ───────────────────────────────────
# Boşsa video sesi hiçbir yere gönderilmez; ses yalnızca tarayıcıda ölçülür.
# Doluysa kullanıcı onay verdiğinde videonun ilk 90 saniyelik sesi (16 kHz mono WAV) bir kez gönderilir, saklanmaz.
# OpenAI uyumlu /v1/audio/transcriptions uç noktası (varsayılan https://api.openai.com, model whisper-1).
SPEECH_TO_TEXT_API_KEY=
SPEECH_TO_TEXT_MODEL=
SPEECH_TO_TEXT_BASE_URL=

# ── E-posta: sezon hatırlatmaları (isteğe bağlı) ─────────────────────────────
# Resend (https://resend.com). İkisi de doluysa /api/cron/season-reminders gerçek e-posta gönderir.
# Boşken demo modunda e-postalar yalnızca bellek içi bir kutuda tutulur; production'da gönderim atlanır.
RESEND_API_KEY=
# Doğrulanmış gönderici, ör. "AdScope <bildirim@alanadiniz.com>"
EMAIL_FROM=

# ── Meta Reklam Kütüphanesi: ilham panosu (isteğe bağlı) ─────────────────────
# Meta geliştirici uygulaması + Reklam Kütüphanesi API kimlik doğrulaması ile alınan erişim anahtarı.
# Boşsa /panel/ilham kurulum adımlarını gösterir. Anahtar yalnızca sunucuda, Authorization başlığında kullanılır.
META_AD_LIBRARY_TOKEN=
# Varsayılan v24.0
META_GRAPH_VERSION=
# Yalnızca testler için (sahte sunucu). APP_MODE=production veya NODE_ENV=production iken yok sayılır.
META_GRAPH_BASE_URL=

# ── Kötüye kullanım ve saklama ──────────────────────────────────────────────
# Kullanıcı başına saatlik en fazla analiz başlatma.
ANALYSIS_HOURLY_LIMIT=20
# Yeni hesaplar için varsayılan saklama süresi (gün, 1–365).
RETENTION_DAYS_DEFAULT=90
# /api/cron/* (retention, season-reminders, newsletter, competitors, welcome) için en az 16 karakterlik rastgele değer (Authorization: Bearer ...).
CRON_SECRET=
# Tek tıkla "E-postalardan çık" bağlantılarını imzalar (en az 32 karakter). Boşsa bağlantılar /panel/ayarlar sayfasına gider.
EMAIL_LINK_SECRET=
# Yalnızca demo (APP_MODE=demo, bellek deposu): /yonetim için virgülle ayrılmış yönetici adresleri ya da "@alan".
# Production: yönetici, Supabase panelinde app_metadata.role = "admin" ile belirlenir.
DEMO_ADMIN_EMAILS=
# Arama motorlarına açmak için true (yalnızca production). Varsayılan kapalı: site noindex ve robots.txt her şeyi engeller.
SITE_INDEXABLE=

# ── Demo veri katmanı (yalnızca Supabase yokken) ────────────────────────────
# Oturum çerezini imzalar. Boşsa süreç başına rastgele üretilir.
DEMO_SESSION_SECRET=
# Bellek içi verinin yeniden başlatmalarda korunması için dosya yolu (isteğe bağlı, yalnızca yerel).
DEMO_STORE_FILE=

# ── Açılış sayfası taraması ──────────────────────────────────────────────────
# YALNIZCA yerel uçtan uca testler için: true iken 127.0.0.1 gibi özel adresler taranabilir.
# APP_MODE=production veya NODE_ENV=production iken her durumda yok sayılır. Üretimde boş bırakın.
LANDING_SCAN_ALLOW_PRIVATE=

# ── Ödeme: Lemon Squeezy (iskelet, hesap açılınca doldurulacak) ─────────────
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_URL=
LEMONSQUEEZY_VARIANT_BASLANGIC=
LEMONSQUEEZY_VARIANT_PROFESYONEL=
LEMONSQUEEZY_VARIANT_AJANS_3=
LEMONSQUEEZY_VARIANT_AJANS_5=
LEMONSQUEEZY_VARIANT_AJANS_10=

# ── Ödeme: Shopier (iskelet; resmî callback belgesi doğrulanmadan açmayın) ──
SHOPIER_ENABLED=false
SHOPIER_CALLBACK_SECRET=
SHOPIER_LINK_BASLANGIC=
SHOPIER_LINK_PROFESYONEL=
# Ajans aylık paketi: marka sayısına göre üç ayrı ürün bağlantısı (3, 5, 10 marka).
SHOPIER_LINK_AJANS_3=
SHOPIER_LINK_AJANS_5=
SHOPIER_LINK_AJANS_10=

# Error monitoring (optional): Sentry DSN. Events are scrubbed (no e-mail, ad copy, secrets, URLs).
SENTRY_DSN=
# Privacy-friendly analytics (optional, public pages only, after consent). Plausible-compatible script.
ANALYTICS_SCRIPT_URL=
ANALYTICS_DOMAIN=

# ── Yapay zekâ görsel ve video üretimi: Google Gemini API (isteğe bağlı) ─────
# Anahtar yoksa "Yapay zekâ görseli" ve "Yapay zekâ videosu" araçları kapalıdır.
# Görsel: Nano Banana 2.1 (gemini-nano-banana-2.1). Video: Gemini Omni Flash (gemini-omni-1.1-flash), 3–10 sn, 720p.
GEMINI_API_KEY=
# Model adlarını değiştirmek için (isteğe bağlı):
GEMINI_IMAGE_MODEL=
GEMINI_VIDEO_MODEL=
# Türkçe dış ses (P11.1) aynı anahtarla çalışır: Gemini 3.8 Flash TTS (gemini-3.8-flash-tts).
# Yalnızca hazır sentetik sesler kullanılır; sağlayıcıya yalnızca okunacak satır gider.
GEMINI_TTS_MODEL=
# Anahtar varken seslendirmeyi kapatmak için "true" yaz (isteğe bağlı).
TTS_DISABLED=
