# ─────────────────────────────────────────────────────────────────────────────
# AdScope ortam değişkenleri. Bu dosyayı .env.local olarak kopyalayın.
# NEXT_PUBLIC_ ile başlayan her değer tarayıcıya gider: oraya ASLA gizli anahtar koymayın.
# ─────────────────────────────────────────────────────────────────────────────

# demo | production
#  demo       : "Demo modu" bandı görünür, demo kredi satın alma açıktır (gerçek ödeme yok).
#               Supabase değişkenleri boşsa bellek içi demo veri katmanı kullanılır.
#  production : demo satın alma kapalıdır, Supabase zorunludur.
APP_MODE=demo

# Uygulamanın dış adresi (e-posta doğrulama bağlantıları için).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API Keys. Publishable key tarayıcıya gidebilir; secret key yalnızca sunucuda.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Sunucuya özel. Yalnızca webhook, kredi fonksiyonları ve hesap silme için kullanılır.
SUPABASE_SECRET_KEY=

# ── Yapay zekâ (isteğe bağlı) ───────────────────────────────────────────────
# Boşsa analizler deterministik kural motoruyla tamamlanır.
ANTHROPIC_API_KEY=
# Varsayılan: claude-opus-5-5
ANTHROPIC_MODEL=

# ── Konuşmayı yazıya dökme (isteğe bağlı) ───────────────────────────────────
# Boşsa video sesi hiçbir yere gönderilmez; ses yalnızca tarayıcıda ölçülür.
# Doluysa kullanıcı onay verdiğinde videonun ilk 90 saniyelik sesi (16 kHz mono WAV) bir kez gönderilir, saklanmaz.
# OpenAI uyumlu /v1/audio/transcriptions uç noktası (varsayılan https://api.openai.com, model whisper-1).
SPEECH_TO_TEXT_API_KEY=
SPEECH_TO_TEXT_MODEL=
SPEECH_TO_TEXT_BASE_URL=

# ── E-posta: sezon hatırlatmaları (isteğe bağlı) ─────────────────────────────
# Resend (https://resend.com). İkisi de doluysa /api/cron/season-reminders gerçek e-posta gönderir.
# Boşken demo modunda e-postalar yalnızca bellek içi bir kutuda tutulur; production'da gönderim atlanır.
RESEND_API_KEY=
# Doğrulanmış gönderici, ör. "AdScope <bildirim@alanadiniz.com>"
EMAIL_FROM=

# ── Kötüye kullanım ve saklama ──────────────────────────────────────────────
# Kullanıcı başına saatlik en fazla analiz başlatma.
ANALYSIS_HOURLY_LIMIT=20
# Yeni hesaplar için varsayılan saklama süresi (gün, 1–365).
RETENTION_DAYS_DEFAULT=90
# /api/cron/retention ve /api/cron/season-reminders için en az 16 karakterlik rastgele değer (Authorization: Bearer ...).
CRON_SECRET=

# ── Demo veri katmanı (yalnızca Supabase yokken) ────────────────────────────
# Oturum çerezini imzalar. Boşsa süreç başına rastgele üretilir.
DEMO_SESSION_SECRET=
# Bellek içi verinin yeniden başlatmalarda korunması için dosya yolu (isteğe bağlı, yalnızca yerel).
DEMO_STORE_FILE=

# ── Açılış sayfası taraması ──────────────────────────────────────────────────
# YALNIZCA yerel uçtan uca testler için: true iken 127.0.0.1 gibi özel adresler taranabilir.
# APP_MODE=production veya NODE_ENV=production iken her durumda yok sayılır. Üretimde boş bırakın.
LANDING_SCAN_ALLOW_PRIVATE=

# ── Ödeme: Lemon Squeezy (iskelet, hesap açılınca doldurulacak) ─────────────
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_URL=
LEMONSQUEEZY_VARIANT_BASLANGIC=
LEMONSQUEEZY_VARIANT_PROFESYONEL=

# ── Ödeme: Shopier (iskelet; resmî callback belgesi doğrulanmadan açmayın) ──
SHOPIER_ENABLED=false
SHOPIER_CALLBACK_SECRET=
SHOPIER_LINK_BASLANGIC=
SHOPIER_LINK_PROFESYONEL=
